OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GITHUB_TOKEN=
GITHUB_REPO=owner/repository
GITHUB_BRANCH=main
# Protect API. Generate a long random value; extension stores it in chrome.storage.
AUTOSOLVER_API_KEY=
ENABLE_SCHEDULER=false
DAILY_TIME=07:00
TIMEZONE=Asia/Kolkata
# Authorized JSON feed only; blank disables daily feed runner.
PROBLEM_FEED_URL=
# Set true to run javac validation (GFG snippets may require wrapper adjustments).
JAVA_COMPILE_CHECK=false
